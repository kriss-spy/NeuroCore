# =============================================================================
# ML / Deep Learning .gitignore
# Extends the standard Python .gitignore with model artifacts, datasets,
# experiment tracking, and common framework outputs.
# =============================================================================

# -----------------------------------------------------------------------------
# Python (core)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.env
.venv
env/
venv/
ENV/
.python-version
pip-log.txt
pip-delete-this-directory.txt
.tox/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.pyo

# Jupyter / IPython
.ipynb_checkpoints/
*.ipynb_checkpoints
profile_default/
ipython_config.py

# -----------------------------------------------------------------------------
# Model weights & checkpoints
# -----------------------------------------------------------------------------
# PyTorch
*.pt
*.pth
*.ckpt
*.bin          # also HuggingFace weights

# TensorFlow / Keras
*.h5
*.hdf5
*.pb
*.tflite
*.tfrecord
saved_model/

# ONNX / Core ML / other
*.onnx
*.mlmodel
*.mlpackage
*.caffemodel
*.prototxt      # keep arch definitions if you want; remove line if so
*.engine        # TensorRT
*.trt

# General checkpoint dirs
checkpoints/
ckpts/
weights/

# -----------------------------------------------------------------------------
# Datasets
# -----------------------------------------------------------------------------
data/
datasets/
*.csv
*.tsv
*.parquet
*.feather
*.arrow
*.h5          # also catches HDF5 data files
*.hdf5
*.npy
*.npz
*.pkl
*.pickle
*.lmdb
*.tfrecords
*.tar
*.tar.gz
*.tar.bz2
*.zip
*.gz
*.7z

# Images / video (raw training data)
# Comment out if you DO version small image sets
# *.jpg
# *.jpeg
# *.png
# *.bmp
# *.tiff
# *.mp4
# *.avi

# -----------------------------------------------------------------------------
# Experiment tracking & logging
# -----------------------------------------------------------------------------
# MLflow
mlruns/
mlartifacts/

# Weights & Biases
wandb/

# TensorBoard
runs/
logs/
tensorboard/
events.out.tfevents.*

# Comet ML
.comet/

# Neptune
.neptune/

# DVC
.dvc/cache
.dvc/tmp
.dvc/plots
*.dvc          # keep if you use DVC, remove this line if so

# ClearML / Trains
.clearml/

# -----------------------------------------------------------------------------
# Outputs, results, visualisations
# -----------------------------------------------------------------------------
outputs/
results/
figures/
plots/
predictions/
submissions/        # Kaggle-style submission CSVs
*.submission.csv

# -----------------------------------------------------------------------------
# Profiling & benchmarking
# -----------------------------------------------------------------------------
*.prof
*.lprof
*.snakeviz

# -----------------------------------------------------------------------------
# IDE / editor
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Environment & secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
secrets.json

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
tmp/
temp/
scratch/
*.log
*.out
nohup.out
core